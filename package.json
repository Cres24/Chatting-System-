    "db:import-legacy": "tsx --env-file=.env.local scripts/import-legacy.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "ably": "^2.30.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
