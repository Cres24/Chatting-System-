{
  "name": "chatting-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "predev": "npm run vendor",
    "dev": "next dev",
    "prebuild": "npm run vendor",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
