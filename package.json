{
  "name": "chatting-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "predev": "npm run vendor",
    "dev": "next dev",
    "prebuild": "npm run vendor",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:import-legacy": "tsx --env-file=.env.local scripts/import-legacy.ts",
    "storage:cors": "tsx --env-file=.env.local scripts/s3-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "ably": "^2.30.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
