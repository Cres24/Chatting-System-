# ---------------------------------------------------------------------------
# Postgres (Neon in production, local Postgres for development)
# ---------------------------------------------------------------------------
# Neon provides two URLs:
#   DATABASE_URL           pooled connection for app traffic (-pooler host)
#   DATABASE_URL_UNPOOLED  direct connection for migrations and scripts
#
# The app also accepts DATABASE_URL_POOLED as an alias for the pooled URL.
# Local example:
#   DATABASE_URL=postgresql:///chatdb_dev
#   DATABASE_URL_UNPOOLED=postgresql:///chatdb_dev
DATABASE_URL=postgres://user:password@localhost:5432/chatdb
DATABASE_URL_UNPOOLED=postgres://user:password@localhost:5432/chatdb

# ---------------------------------------------------------------------------
# App origin
# ---------------------------------------------------------------------------
# Used for the CSRF origin check and for secure cookies in production.
# Set this to the production URL (no trailing slash), e.g.
#   APP_URL=https://chatting-system.vercel.app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Ably (realtime)
# ---------------------------------------------------------------------------
# Create an Ably app and copy an API key with publish/subscribe capability.
# Leave empty to disable realtime; the browser then polls the REST API.
ABLY_API_KEY=

# ---------------------------------------------------------------------------
# Neon Object Storage (attachments + avatars)
# ---------------------------------------------------------------------------
# `neon deploy` injects the AWS_* values for the linked branch. The bucket is
# declared in neon.ts and must be private.
S3_BUCKET=uploads
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
