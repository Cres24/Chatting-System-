# ---------------------------------------------------------------------------
# Postgres (Neon in production, local Postgres for development)
# ---------------------------------------------------------------------------
# Local example:
#   DATABASE_URL=postgresql:///chatdb_dev
#
# Neon: copy the *pooled* connection string (the host contains "-pooler") and
# keep ?sslmode=require. Serverless functions open short-lived connections, so
# the pooler is important on the free tier.
DATABASE_URL=postgres://user:password@localhost:5432/chatdb

# ---------------------------------------------------------------------------
# App origin
# ---------------------------------------------------------------------------
# Used for the CSRF origin check and for secure cookies in production.
# Set this to the production URL (no trailing slash), e.g.
#   APP_URL=https://chatting-system.vercel.app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Ably (realtime)
# ---------------------------------------------------------------------------
# Create an Ably app and copy an API key with publish/subscribe capability.
# Leave empty to disable realtime; the browser then polls the REST API.
ABLY_API_KEY=

# ---------------------------------------------------------------------------
# Vercel Blob (attachments + avatars)
# ---------------------------------------------------------------------------
# Injected automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Access mode of the connected Blob store.
#   private (recommended): files are streamed through authenticated
#                          /api/media, /api/avatar, and /api/group-avatar routes.
#   public:                 files can also be fetched directly from their Blob
#                          URL (only use this if the store itself is public).
BLOB_ACCESS=private
